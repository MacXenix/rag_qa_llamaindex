# LLM provider: ollama | openai | gemini | groq
LLM_PROVIDER=groq

# Model names (optional — these are the defaults)
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_LLM_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=nomic-embed-text
GROQ_LLM_MODEL=llama-3.1-70b-versatile
GROQ_EMBEDDING_MODEL=nomic-embed-text

# Groq (required if LLM_PROVIDER=groq) — free at console.groq.com
GROQ_API_KEY=

# OpenAI (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Gemini (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://ragqa:ragqa@localhost:5432/ragqa

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Tavily (optional — for agent web search tool)
TAVILY_API_KEY=

# Retrieval mode: basic | hyde | rerank | hyde+rerank
RETRIEVAL_MODE=basic