# LLM provider: ollama | openai | gemini
LLM_PROVIDER=ollama

# OpenAI (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Gemini (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://ragqa:ragqa@localhost:5432/ragqa

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Tavily (optional — for agent web search tool)
TAVILY_API_KEY=